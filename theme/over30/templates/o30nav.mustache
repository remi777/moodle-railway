{{!
    over30 shared top navigation — identical on EVERY page.

    Renders the SAME functional pieces as theme_boost/navbar (primary navigation
    incl. Site administration, edit-mode switch, notifications/messages popovers,
    language menu and the user menu) inside the over30 shell + styling. All data
    comes from the standard navbar context, so this works both as the global
    theme_boost/navbar override and when included directly by the custom layouts.
}}
<header class="o30-nav navbar-expand">
    <div class="o30-container o30-nav__inner">
        <a class="o30-nav__brand" href="{{{ config.wwwroot }}}/" aria-label="over30">
            <span class="o30-nav__logoimg" role="img" aria-label="over30"></span>
        </a>

        {{#primarymoremenu}}
            <div class="o30-nav__primary primary-navigation">
                {{> core/moremenu}}
            </div>
        {{/primarymoremenu}}

        <div class="o30-nav__cta navbar-nav ms-auto">
            {{#langmenu}}
                {{> theme_boost/language_menu }}
            {{/langmenu}}
            {{{ output.edit_switch }}}
            {{# output.navbar_plugin_output }}
                {{{ . }}}
            {{/ output.navbar_plugin_output }}
            {{#usermenu}}
                <div class="usermenu-container o30-nav__user" data-region="usermenu">
                    {{> core/user_menu }}
                </div>
            {{/usermenu}}
        </div>
    </div>
</header>
