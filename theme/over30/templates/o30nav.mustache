{{!
    over30 shared top navigation — identical on EVERY page.

    Simple, always-visible hardcoded links (no core/moremenu, which collapses /
    empties unpredictably), plus the native edit-mode switch, notifications /
    messages and the user menu. Self-sufficient: uses only globally-available
    data (config.wwwroot, output.*, usermenu) so it works as the global
    theme_boost/navbar override and when included by the custom layouts.
}}
<header class="o30-nav navbar-expand">
    <div class="o30-container o30-nav__inner">
        <a class="o30-nav__brand" href="{{{ config.wwwroot }}}/" aria-label="over30">
            <span class="o30-nav__logoimg" role="img" aria-label="over30"></span>
        </a>
        <nav class="o30-nav__links">
            <a href="{{{ config.wwwroot }}}/">Strona główna</a>
            <a href="{{{ config.wwwroot }}}/course/">Kursy</a>
            <a href="{{{ config.wwwroot }}}/my/">Kokpit</a>
            <a class="o30-nav__admin" href="{{{ config.wwwroot }}}/admin/search.php">Administracja</a>
        </nav>
        <div class="o30-nav__cta navbar-nav ms-auto">
            {{{ output.edit_switch }}}
            {{# output.navbar_plugin_output }}
                {{{ . }}}
            {{/ output.navbar_plugin_output }}
            {{#usermenu}}
                <div class="usermenu-container o30-nav__user" data-region="usermenu">
                    {{> core/user_menu }}
                </div>
            {{/usermenu}}
        </div>
    </div>
</header>
